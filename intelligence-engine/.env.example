INTELLIGENCE_ENGINE_TOKEN=dev-intelligence-token
AGIB_API_BASE_URL=http://127.0.0.1:3001
APP_ENV=development
PORT=8100
# Durable KIP snapshots.
# Render order: upgrade to Starter (no disk) → attach disk /var/data/kip → set:
# KIP_DATA_DIR=/var/data/kip
# Optional strict mode after disk is live:
# KIP_REQUIRE_PERSISTENT=1
# Emergency only (unsafe): KIP_ALLOW_EPHEMERAL=1
# Prefer Gemini when set; OpenAI remains a soft fallback for CIO prose.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# Editorial Intelligence Layer (writer only — AGIB remains the brain)
# EDITORIAL_LAYER=true
# ASK_AGI_EDITORIAL_LAYER=true
# EDITORIAL_PROVIDER=gemini
# OPENAI_API_KEY=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Ask AGI improvement worker (Railway agi-improvement-worker only)
# AGI_ENGINE_URL=https://agib-intelligence-engine-production.up.railway.app
# OPENAI_API_KEY=
# AGI_IMPROVEMENT_QUESTION_LIMIT=100
# AGI_IMPROVEMENT_CONCURRENCY=2
# AGI_IMPROVEMENT_BATCH_SIZE=10
# AGI_IMPROVEMENT_MAX_RETRIES=3
# AGI_IMPROVEMENT_OUTPUT_DIR=/data/agi-improvement
# AGI_IMPROVEMENT_SMOKE_TEST=0
# AGI_IMPROVEMENT_DRY_RUN=0

# WS02 Market Data Platform (optional; providers skipped if unset)
# INDIAN_API_KEY=
# INDIAN_API_BASE_URL=https://stock.indianapi.in
# FINNHUB_API_KEY=
# FINNHUB_BASE_URL=https://finnhub.io/api/v1
# FMP_API_KEY=
# FMP_BASE_URL=https://financialmodelingprep.com/api/v3

# YFP V1 — Yahoo Finance (secondary; no API key)
# YAHOO_PROVIDER=true
# YAHOO_PROFILE=true
# YAHOO_FINANCIALS=true
# YAHOO_EARNINGS=true
# YAHOO_VALUATION=true
# YAHOO_OWNERSHIP=true
# YAHOO_OPTIONS=true
# YAHOO_FINANCIAL_HISTORY=true
# YAHOO_VALUATION_HISTORY=true
# YAHOO_CID_ENRICHMENT=true

# FAA live acquisition — strategic search + enrichment (server-side only)
# FAA=true
# FAA_LIVE_FETCH=true
# FAA_SEARCH_API=true
# FAA_PLAYWRIGHT=true          # headless Chromium JS fetch + free DuckDuckGo search
# EXA_API_KEY=                 # preferred for research / industry / publications
# FIRECRAWL_API_KEY=           # deep search + URL→markdown enrichment
# BROWSERBASE_API_KEY=         # JS-heavy / exchange / IR fallback fetch
# TAVILY_API_KEY=              # optional news/general coverage
# After enabling Playwright: playwright install chromium

